import math
import time

SERVER_RATE = 10**8
TIME_LIMIT = 600

def m1_duplicate_detector(products):
    duplicates = []
    comparisons = 0
    for i in range(len(products) - 1):
        for j in range(i + 1, len(products)):
            comparisons += 1
            if products[i][0] == products[j][0] and products[i][1] == products[j][1]:
                duplicates.append(j)
    return duplicates, comparisons

def m1_count(n):
    return n * (n - 1) // 2

def m2_rate_limiter(n):
    i = 1
    audits = 0
    while i < n:
        audits += i
        i *= 2
    return audits

def m2_count(n):
    if n <= 1:
        return 0
    return 2**math.ceil(math.log2(n)) - 1

def linear_search(items, target):
    comparisons = 0
    for item in items:
        comparisons += 1
        if item == target:
            return True, comparisons
    return False, comparisons

def binary_search(items, target):
    left = 0
    right = len(items) - 1
    comparisons = 0
    while left <= right:
        mid = (left + right) // 2
        comparisons += 1
        if items[mid] == target:
            return True, comparisons
        elif items[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return False, comparisons

def m4_current_power2(n):
    return 2 * n**2 - n

def m4_redesigned_power2(n):
    return int(n * math.log2(n) + n)

def m5_power2(n):
    k = int(math.log2(n))
    return n * k * (k + 1) // 2 + n

def report_generator_cost(n):
    return 3 * n**2 + 10 * n * math.log2(n) + 50

def server_time(operations):
    return operations / SERVER_RATE

def format_time(seconds):
    if seconds < 1:
        return f"{seconds:.6f} seconds"
    if seconds < 60:
        return f"{seconds:.2f} seconds"
    return f"{seconds / 60:.2f} minutes"

def show_result(name, operations, complexity, space):
    seconds = server_time(operations)
    status = "EXCEEDS 10 MINUTES" if seconds > TIME_LIMIT else "WITHIN 10 MINUTES"
    print("\n" + name)
    print("Operation count:", f"{operations:,.2f}")
    print("Estimated server time:", format_time(seconds))
    print("Time complexity:", complexity)
    print("Space complexity:", space)
    print("10-minute check:", status)

