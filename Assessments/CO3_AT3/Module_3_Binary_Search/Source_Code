
# CO3 DAA - Module 3: Binary Search
# Order Lookup System

def binary_search_first(orders, target):
    low = 0
    high = len(orders) - 1
    result = -1
    comparisons = 0

    while low <= high:
        mid = (low + high) // 2
        comparisons += 1

        if orders[mid][0] == target:
            result = mid
            high = mid - 1

        elif orders[mid][0] < target:
            low = mid + 1

        else:
            high = mid - 1

    return result, comparisons


# Main program
if __name__ == "__main__":
