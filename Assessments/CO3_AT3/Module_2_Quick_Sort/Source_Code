
# CO3 DAA - Module 2: Quick Sort
# Live Seller Leaderboard

def median_of_three_index(arr, low, high):
    mid = (low + high) // 2

    candidates = [
        (arr[low], low),
        (arr[mid], mid),
        (arr[high], high)
    ]

    candidates.sort(key=lambda item: item[0])
    return candidates[1][1]


def partition(arr, low, high, stats):
    pivot_index = median_of_three_index(arr, low, high)

    arr[pivot_index], arr[high] = (
        arr[high], arr[pivot_index]
    )

    pivot = arr[high]
    i = low - 1

    for j in range(low, high):
        stats["comparisons"] += 1

        if arr[j] <= pivot:
            i += 1
            arr[i], arr[j] = arr[j], arr[i]

    arr[i + 1], arr[high] = (
        arr[high], arr[i + 1]
    )

    return i + 1


def quick_sort(arr, low=0, high=None, stats=None):
    if high is None:
        high = len(arr) - 1

    if stats is None:
        stats = {"comparisons": 0}

    if low < high:
        p = partition(arr, low, high, stats)

        quick_sort(arr, low, p - 1, stats)
        quick_sort(arr, p + 1, high, stats)

    return stats


# Main program
if __name__ == "__main__":
    scores = [42, 17, 63, 8, 55, 29]

    print("Original seller scores:", scores)

    stats = quick_sort(scores)

