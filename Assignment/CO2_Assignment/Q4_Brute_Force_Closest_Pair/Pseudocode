
ALGORITHM: Brute-Force Closest Pair

INPUT:
    A list P containing n two-dimensional points

OUTPUT:
    The closest pair, minimum distance, and operation counts

1. If n < 2:
       Report that at least two points are required.
       Stop.
2. Set minimum_distance = infinity.
3. Set closest_pair = NONE.
4. Set pairs_examined = 0.
5. Set distance_calculations = 0.

6. FOR i = 0 TO n - 2:
       FOR j = i + 1 TO n - 1:
           Increment pairs_examined.
           Calculate the Euclidean distance:

           distance = square_root(
               (P[i].x - P[j].x)^2
               + (P[i].y - P[j].y)^2
           )

           Increment distance_calculations.

           IF distance < minimum_distance:
               Set minimum_distance = distance.
               Set closest_pair = (P[i], P[j]).
           END IF
       END FOR
   END FOR

7. Display closest_pair and minimum_distance.
8. Display pairs_examined and distance_calculations.

END ALGORITHM

