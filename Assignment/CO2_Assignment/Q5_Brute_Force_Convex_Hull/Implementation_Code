
# Q5: Brute-Force Convex Hull

import math
import random
import time
import matplotlib.pyplot as plt


def cross_product(a, b, c):
    return (
        (b[0] - a[0]) * (c[1] - a[1])
        - (b[1] - a[1]) * (c[0] - a[0])
    )


def between(a, b, c):
    # True if c lies on segment AB, excluding endpoints
    return (
        min(a[0], b[0]) <= c[0] <= max(a[0], b[0])
        and min(a[1], b[1]) <= c[1] <= max(a[1], b[1])
        and c != a and c != b
    )


def brute_force_convex_hull(points):
    points = list(dict.fromkeys(points))

    if len(points) < 3:
        raise ValueError("At least three distinct points are required.")

    edges = set()
    candidate_pairs = 0
    orientation_checks = 0

    n = len(points)

    for i in range(n):
        for j in range(i + 1, n):
            a, b = points[i], points[j]
            candidate_pairs += 1
            left = False
            right = False
            collinear = []

            for k, c in enumerate(points):
                if k == i or k == j:
                    continue

                orientation_checks += 1
                value = cross_product(a, b, c)

                if value > 0:
                    left = True
                elif value < 0:
                    right = True
                else:
                    collinear.append(c)

            # Points on both sides mean this is not a hull edge.
            if left and right:
                continue

            # Keep only the extreme endpoints of a collinear boundary.
            if any(between(a, b, c) for c in collinear):
                continue

            edges.add((a, b))
            edges.add((b, a))

    if not edges:
        raise ValueError("No polygonal hull found; check the point set.")

    vertices = set()
    for a, b in edges:
        vertices.add(a)
        vertices.add(b)

    # Order hull vertices around their centroid.
    cx = sum(p[0] for p in vertices) / len(vertices)
    cy = sum(p[1] for p in vertices) / len(vertices)

    hull = sorted(
        vertices,
        key=lambda p: math.atan2(p[1] - cy, p[0] - cx)
    )

    return hull, candidate_pairs, orientation_checks


def show_hull(points, hull, title):
    closed_hull = hull + [hull[0]]

    plt.figure(figsize=(6, 5))
    plt.scatter(
        [p[0] for p in points],
        [p[1] for p in points],
        label="Input points"
    )
    plt.plot(
        [p[0] for p in closed_hull],
        [p[1] for p in closed_hull],
        marker="o",
        label="Convex hull"
    )

    plt.title(title)
    plt.xlabel("X coordinate")
    plt.ylabel("Y coordinate")
    plt.grid(True)
    plt.legend()
    plt.show()


print("Q5: BRUTE-FORCE CONVEX HULL")
print("=" * 60)

# Test 1: Boundary and interior points
test1 = [
    (0, 0), (4, 0), (4, 4), (0, 4),
    (2, 2), (1, 2), (3, 1)
]

# Test 2: Irregular configuration with interior points
test2 = [
    (-2, 0), (0, -3), (4, -1), (5, 3),
    (1, 5), (-3, 4), (1, 1), (2, 2)
]

for name, points in [
    ("Test 1: Square with interior points", test1),
    ("Test 2: Irregular point configuration", test2)
]:
    hull, pairs, checks = brute_force_convex_hull(points)

    print(f"\n{name}")
    print("Input points:", points)
    print("Hull vertices:", hull)
    print("Candidate pairs examined:", pairs)
    print("Orientation checks:", checks)

    show_hull(points, hull, name)


# Growth experiment
print("\nSCALABILITY EXPERIMENT")
print("-" * 60)
print(f"{'Points':<12}{'Candidate pairs':<20}"
      f"{'Orientation checks':<22}{'Time (s)':<12}")

random.seed(42)

for n in [10, 20, 40, 80]:
    points = set()

    while len(points) < n:
        points.add((
            random.uniform(0, 1000),
            random.uniform(0, 1000)
        ))

    points = list(points)

    start = time.perf_counter()
    hull, pairs, checks = brute_force_convex_hull(points)
    elapsed = time.perf_counter() - start

    print(f"{n:<12}{pairs:<20}{checks:<22}{elapsed:.6f}")

print("\nExperiments completed.")

