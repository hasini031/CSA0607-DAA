
def word_break(text, dictionary):
    n = len(text)

    # Initialize DP table
    dp = [False] * (n + 1)
    dp[0] = True

    # Fill DP table
    for i in range(1, n + 1):
        for j in range(0, i):
            if dp[j] and text[j:i] in dictionary:
                dp[i] = True
                break

    print("DP Table:")
    print(dp)

    if dp[n]:
        print("The string can be segmented into dictionary words.")

        # Reconstruct words
        words = []
        i = n

        while i > 0:
            for j in range(i - 1, -1, -1):
                if dp[j] and text[j:i] in dictionary:
                    words.append(text[j:i])
                    i = j
                    break

        words.reverse()
        print("Words:", words)
    else:
        print("The string cannot be segmented into dictionary words.")


# Main program
text = "applepen"
dictionary = {"apple", "pen"}

word_break(text, dictionary)

def knapsack(weights, values, capacity, items):
    n = len(weights)

    # Initialize DP table
    dp = [[0 for _ in range(capacity + 1)]
          for _ in range(n + 1)]

    # Fill the DP table
    for i in range(1, n + 1):
        for w in range(capacity + 1):
            if weights[i - 1] <= w:
                include = values[i - 1] + dp[i - 1][w - weights[i - 1]]
                exclude = dp[i - 1][w]
                dp[i][w] = max(include, exclude)
            else:
                dp[i][w] = dp[i - 1][w]

    # Reconstruct selected items
    selected = []
    w = capacity

    for i in range(n, 0, -1):
        if dp[i][w] != dp[i - 1][w]:
            selected.append(items[i - 1])
            w -= weights[i - 1]

    selected.reverse()

    print("DP Table:")
    for row in dp:
        print(row)

    print("\nSelected Items:")
    for item in selected:
        print(item)

    print("Maximum Value:", dp[n][capacity])


# Main program
items = ["P", "Q", "R", "S"]
weights = [2, 3, 4, 5]
values = [12, 20, 25, 30]
capacity = 7

knapsack(weights, values, capacity, items)

