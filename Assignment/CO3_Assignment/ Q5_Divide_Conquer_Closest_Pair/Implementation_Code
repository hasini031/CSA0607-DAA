
import math

def distance(p1, p2):
    return math.sqrt((p1[0] - p2[0])**2 + (p1[1] - p2[1])**2)


def closest_pair(points):
    points = sorted(points, key=lambda p: p[0])

    def solve(pts):
        n = len(pts)

        if n <= 3:
            best = float('inf')
            pair = None

            for i in range(n):
                for j in range(i + 1, n):
                    d = distance(pts[i], pts[j])
                    if d < best:
                        best = d
                        pair = (pts[i], pts[j])

            return best, pair

        mid = n // 2
        mid_x = pts[mid][0]

        left_dist, left_pair = solve(pts[:mid])
        right_dist, right_pair = solve(pts[mid:])

        if left_dist < right_dist:
            best, pair = left_dist, left_pair
        else:
            best, pair = right_dist, right_pair

        strip = [p for p in pts if abs(p[0] - mid_x) < best]
        strip.sort(key=lambda p: p[1])

        for i in range(len(strip)):
            for j in range(i + 1, len(strip)):
                if strip[j][1] - strip[i][1] >= best:
                    break

                d = distance(strip[i], strip[j])

                if d < best:
                    best = d
                    pair = (strip[i], strip[j])

        return best, pair

    return solve(points)


points = [(2, 3), (12, 30), (40, 50),
          (5, 1), (12, 10), (3, 4)]

minimum, pair = closest_pair(points)

print("Points:", points)
print("Closest Pair:", pair)
print("Minimum Distance:", round(minimum, 2))

