
# Meet-in-the-Middle Algorithm
# Aim: Find a subset whose sum equals the target.

def generate_subsets(arr):
    subsets = []

    for mask in range(1 << len(arr)):
        subset = []

        for i in range(len(arr)):
            if mask & (1 << i):
                subset.append(arr[i])

        subsets.append((sum(subset), subset))

    return sorted(subsets)


def meet_in_middle(arr, target):
    mid = len(arr) // 2

    left = generate_subsets(arr[:mid])
    right = generate_subsets(arr[mid:])

    i = 0
    j = len(right) - 1

    while i < len(left) and j >= 0:
        total = left[i][0] + right[j][0]

        if total == target:
            return left[i][1] + right[j][1]
        elif total < target:
            i += 1
        else:
            j -= 1

    return None


arr = [3, 34, 4, 12, 5, 2]
target = 9

result = meet_in_middle(arr, target)

print("Given Array:", arr)
print("Target Sum:", target)

if result is not None:
    print("Subset Found:", result)
    print("Subset Sum:", sum(result))
else:
    print("No Subset Found")
